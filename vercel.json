{
  "cleanUrls": true,
  "redirects": [
    { "source": "/privacy", "destination": "/drft/privacy/", "permanent": true },
    { "source": "/terms", "destination": "/drft/terms/", "permanent": true },
    { "source": "/support", "destination": "/drft/support/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
